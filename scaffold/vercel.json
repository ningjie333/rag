{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "experimental": {
    "services": {
      "frontend": {
        "routePrefix": "/",
        "framework": "vite"
      },
      "backend": {
        "entrypoint": "backend",
        "routePrefix": "/_/backend"
      }
    }
  }
}